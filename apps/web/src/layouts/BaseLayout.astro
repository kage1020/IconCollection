---
import '../styles/global.css';
export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-neutral-50 text-neutral-900">
    <slot />
  </body>
</html>
